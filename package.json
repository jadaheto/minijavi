{
  "name": "kiosco-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "Avatar 3D parlante: NestJS + Three.js + Deepgram + DeepSeek + ElevenLabs",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-vendor.mjs",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "conocimiento": "tsc -p tsconfig.json && node dist/knowledge/ingest.js",
    "restaurar": "node dist/db/restore.js",
    "negocio:cargar": "tsc -p tsconfig.json && node --no-warnings dist/business/ingest.js",
    "verificar": "tsc -p tsconfig.json && node --no-warnings dist/verify/verify.js",
    "latencia": "node scripts/latencia.mjs",
    "probar-modelo": "tsc -p tsconfig.json && node --no-warnings dist/llm/probe.js",
    "avatar": "tsc -p tsconfig.json && node --no-warnings dist/avatars/cli.js",
    "cliente:nuevo": "tsc -p tsconfig.json && node --no-warnings dist/business/new-client.js nuevo",
    "cliente:revisar": "tsc -p tsconfig.json && node --no-warnings dist/business/new-client.js revisar"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/platform-ws": "^12.5.0",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/websockets": "^12.5.0",
    "opusscript": "^0.1.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "werift": "^0.27.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "gsap": "^3.15.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
