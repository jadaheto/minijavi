# Copiar a .env y completar. El .env nunca se sube al repositorio.

# Puerto HTTP/WebSocket del servicio (Easypanel lo puede fijar).
PORT=3000

# --- Acceso y limites ---
# Codigo de acceso. Vacio = cualquiera con la URL puede hablar con el avatar (y gastar creditos).
ACCESS_CODE=
# Conversaciones simultaneas permitidas.
MAX_SESSIONS=2
# Duracion maxima de una conversacion, en segundos.
SESSION_MAX_SECONDS=600
# Cierre por inactividad (sin voz reconocida), en segundos.
IDLE_SECONDS=120
# Palabras que deben reconocerse para interrumpir al avatar mientras habla (evita cortes por eco o ruido).
BARGE_IN_WORDS=3

# --- Deepgram (voz a texto). Verificado en la documentacion el 2026-11-13 ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# multi = detecta el idioma (el avatar responde en el idioma en que le hablan); es = solo espanol.
DEEPGRAM_LANGUAGE=multi

# --- DeepSeek (LLM). Verificado en la documentacion el 2026-11-13 ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# --- ElevenLabs (texto a voz con timestamps) ---
ELEVENLABS_API_KEY=
# Identificador de la voz (espanol latino). Debe pertenecer a la misma cuenta que la clave.
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo: mas economico y rapido (~440 ms). Alternativas: eleven_v4, eleven_flash_v2_5.
ELEVENLABS_MODEL_ID=eleven_v4_turbo

# --- Personalidad ---
# El system prompt sale de SYSTEM_PROMPT o, si esta vacio, del archivo SYSTEM_PROMPT_FILE.
SYSTEM_PROMPT=
SYSTEM_PROMPT_FILE=prompts/system.md
# Saludo al iniciar la conversacion (vacio = no saluda).
GREETING=¡Hola! Soy Javier. ¿De qué quieres hablar?
# Zona horaria de la herramienta hora_actual.
TIMEZONE=America/Bogota
# Ciudad por defecto de la herramienta clima (cuando la persona no dice ninguna).
DEFAULT_CITY=Sincelejo

# --- Modo dueño (herramientas privadas solo en dispositivos registrados) ---
# Clave larga (minimo 16 caracteres) para registrar un dispositivo en /dueno.html. Vacia = modo dueño desactivado.
OWNER_SECRET=
# Dias que dura el pase de un dispositivo registrado.
OWNER_DAYS=90
# Carpeta donde se guarda la lista de dispositivos. En Easypanel montar un volumen en /app/data.
DATA_DIR=data
# MCP de Plane (solo consulta). La clave nunca sale del backend.
PLANE_MCP_URL=
PLANE_API_KEY=

# --- Captacion de clientes ---
# Los interesados se guardan en DATA_DIR/leads.db (SQLite). Aviso opcional por cada uno nuevo: URL que recibe un POST
# con {event, lead} (por ejemplo un webhook de n8n que te escriba por WhatsApp o correo). Vacio = sin aviso.
LEADS_WEBHOOK_URL=
# Aviso por Telegram de cada interesado nuevo: token del bot (BotFather) e ID de la conversacion destino.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Botones de Telegram para aprobar o rechazar lo que el avatar quiere hacer por su cuenta. El avatar consulta a Telegram
# cada pocos segundos (no registra ningún webhook). Solo UN proceso puede hacerlo por bot: en un servidor local que use
# el mismo bot que producción, pon 0 para no quitarle las pulsaciones.
TELEGRAM_BUTTONS=1

# --- Tarjetas en pantalla y QR de contacto ---
# true = el avatar muestra tarjetas de servicios y el QR mientras habla; false = no muestra ninguna.
CARDS_ENABLED=false
# Direccion a la que lleva el codigo QR (por ejemplo https://wa.me/57XXXXXXXXXX). Vacia = sin QR.
CONTACT_URL=
CONTACT_TITLE=Hablemos por WhatsApp
CONTACT_CAPTION=Escanea para escribirle a Javier
# Tarjetas de servicios (titulo y puntos). Editar el archivo para cambiarlas o agregar proyectos.
CARDS_FILE=content/tarjetas.json

# --- Memoria de visitantes ---
# Dias que el avatar recuerda a quien vuelve (nombre y resumen de la ultima charla). 0 = sin memoria.
# En un kiosco compartido abrir la pagina con ?kiosco=1 para que no se use.
VISITOR_MEMORY_DAYS=90

# --- WhatsApp (API de Meta): plantilla que recibe cada interesado al dejar su numero ---
# Token de acceso de la API. Vacio = no se envia nada.
WHATSAPP_TOKEN=
# Identificador del numero de telefono (no es el numero).
WHATSAPP_PHONE_NUMBER_ID=
# Nombre e idioma de la plantilla aprobada. Variables del cuerpo: {{1}} nombre, {{2}} interes.
WHATSAPP_TEMPLATE=minijavi_bienvenida
WHATSAPP_TEMPLATE_LANG=es_MX
# Direccion publica (https) de la imagen de cabecera. El repositorio la sirve en /img/cabecera.jpg.
WHATSAPP_HEADER_IMAGE_URL=
# Version de la API de Graph e indicativo que se agrega a un celular de 10 digitos.
WHATSAPP_API_VERSION=v27.0
WHATSAPP_DEFAULT_COUNTRY=57

# --- Base de conocimiento (RAG): embeddings de NVIDIA + Qdrant ---
# Sin NVIDIA_API_KEY o sin QDRANT_URL queda desactivada. Los documentos se cargan con: npm run conocimiento
NVIDIA_API_KEY=
EMBED_MODEL=nvidia/nemotron-3.5-embed-8b
QDRANT_URL=
# Clave de Qdrant (tambien se acepta con el nombre QDRANT__SERVICE__API_KEY).
QDRANT_API_KEY=
QDRANT_COLLECTION=minijavi
# Carpeta con publico/ y privado/ (archivos .md o .txt). Fragmentos por consulta y parecido minimo (0 a 1).
KNOWLEDGE_DIR=conocimiento
KNOWLEDGE_TOP_K=3
KNOWLEDGE_MIN_SCORE=0.25

# --- Llamadas de WhatsApp (webhook en /webhooks/whatsapp) ---
# Texto que inventas y que tambien se escribe en Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta: valida que el aviso viene de Meta.
WHATSAPP_APP_SECRET=
# Alternativa: secreto compartido si los avisos de llamada los reenvia otro sistema (cabecera X-Forward-Secret).
WHATSAPP_FORWARD_SECRET=
# rechazar (por defecto) | prueba: contesta, envia dos pitidos y mide el audio (etapa 2) | conversar: el avatar atiende la llamada.
CALL_MODE=rechazar
# IP publica del VPS y rango de puertos UDP del audio. El rango debe publicarse en el contenedor (mismos numeros)
# y abrirse en el firewall del servidor. Un puerto por llamada simultanea.
CALL_PUBLIC_IP=
CALL_UDP_PORT_MIN=40000
CALL_UDP_PORT_MAX=40009
CALL_MAX=2
CALL_TEST_SECONDS=20

# --- n8n: respuestas por texto en WhatsApp ---
# Capa de decisiones. Jev (TypeSafe) es OPCIONAL: con su clave decide Jev y DeepSeek queda de respaldo; sin ella decide
# DeepSeek con preguntas cerradas y nada más cambia. Encenderlo o apagarlo es solo esta variable.
JEV_API_KEY=
# Versión de Jev. Conviene una versión fija: los umbrales de confianza del panel se ajustan contra ella.
JEV_MODEL=jev-1.14.0
# Modelo capaz (OPCIONAL): un segundo modelo, de cualquier proveedor, solo para encargos largos del dueño. Tarda más en
# empezar a responder, por eso nunca se usa con visitantes. Además hay que encenderlo en el panel (Decisiones).
# Proveedor: deepseek | openai | gemini | kimi | grok | anthropic | otro (cualquier API compatible con OpenAI).
MODELO_CAPAZ_PROVEEDOR=
# Nombre del modelo tal como lo da el proveedor (por ejemplo deepseek-v4-pro). No hay valor por defecto.
MODELO_CAPAZ=
# Clave de ese proveedor. Con deepseek se puede dejar vacía: usa DEEPSEEK_API_KEY.
MODELO_CAPAZ_KEY=
# Solo con "otro" (o para cambiar la dirección de un proveedor): base de la API, sin /chat/completions.
MODELO_CAPAZ_URL=
# Campos extra para la petición, en JSON. Ejemplo: {"reasoning_effort":"low"}
MODELO_CAPAZ_EXTRA=
# Segundos que se espera a que EMPIECE a responder; si no, ese turno lo responde el modelo de siempre.
MODELO_CAPAZ_ESPERA_S=8
# Después de configurarlo: `npm run probar-modelo` hace una pregunta y usa una herramienta de verdad contra ese modelo.
# Días que se conserva el registro de decisiones.
DECISIONS_KEEP_DAYS=90
# Identificador del negocio dueño de los datos nuevos (decisiones, ajustes). Hoy hay uno solo.
BUSINESS_ID=principal

# Quien responde los mensajes de WhatsApp (texto, imagenes, notas de voz): avatar (por defecto) | n8n | off.
# avatar: responde el propio avatar con su modelo, conocimiento, portafolio y registro de interesados.
# n8n: se reenvian a N8N_WEBHOOK_URL como antes (sirve para volver atras si algo falla).
WHATSAPP_REPLIES=avatar
# Minutos sin mensajes para cerrar un chat (resumen, embudo e informe) y tope de respuestas por hora a un mismo numero.
WHATSAPP_IDLE_MINUTES=30
WHATSAPP_MAX_PER_HOUR=40
# Solo con WHATSAPP_REPLIES=n8n: webhook de n8n al que el avatar reenvia los mensajes.
N8N_WEBHOOK_URL=
# Secreto compartido: va en la cabecera X-Forward-Secret hacia n8n, y n8n lo usa para consultar /knowledge/search.
N8N_SECRET=

# Taller de programacion (solo modo dueño): Claude Code con TU suscripcion. Generar con `claude setup-token` (dura un año).
# Vacio = sin taller. La suscripcion no se puede usar para atender a visitantes: por eso solo existe en modo dueño.
CLAUDE_CODE_OAUTH_TOKEN=
# Modelo por defecto de Claude Code (el avatar pregunta al empezar si se cambia: fable, opus, sonnet, haiku), tope por
# encargo, cada cuantos segundos cuenta en voz como va (0 = nunca) y direccion publica para enlaces y QR.
CLAUDE_MODEL=claude-opus-5-5
TALLER_MAX_MINUTES=30
TALLER_STATUS_SECONDS=90
PUBLIC_URL=
# En Docker el Dockerfile ya pone TALLER_USER=taller (usuario separado). En local se deja vacio.
TALLER_USER=

# Musica de fondo en modo dueño (YouTube Data API v3; la cuota por defecto son 100 busquedas al dia). Vacio = sin musica.
YOUTUBE_API_KEY=
MUSIC_DEFAULT_QUERY=lofi para programar
MUSIC_VOLUME=15

# Voz. Sin ELEVENLABS_API_KEY (o con TTS_PROVIDER=browser) el avatar habla con la voz del navegador: no cuesta, pero
# suena distinta en cada dispositivo, no es la voz clonada y las llamadas de WhatsApp quedan desactivadas.
TTS_PROVIDER=
# Parte del nombre de la voz del navegador que se prefiere (por ejemplo "Paulina" o "Google español") y su velocidad.
BROWSER_VOICE=
BROWSER_VOICE_RATE=1

# Modo suspensión: al decir "silénciate", "cállate" o "para" el avatar deja de responder hasta oír su nombre.
# WAKE_WORDS: la palabra para despertarlo y las formas en que el reconocedor suele escribirla (la primera se muestra).
# SUSPEND_MAX_MINUTES: tras ese tiempo suspendido se cierra la escucha y solo despierta con un toque en la pantalla.
WAKE_WORDS=javi,javier,xavi,havi,habi,jabi,jabe,javy,jaby,yavi,yabi
SUSPEND_MAX_MINUTES=120

# Consumo: el avatar mide por día minutos de escucha, tokens, caracteres de voz, búsquedas y encargos (DATA_DIR/uso.db).
# Opcional: precio en dólares por unidad de cada medida, para ver un costo estimado. Tómalos de la tarifa de tu plan.
# Medidas: deepgram_s, deepgram_pre_s (segundos), deepseek_in, deepseek_cache, deepseek_out (tokens), eleven_chars.
# deepseek_cache ya está contado dentro de deepseek_in: ponle precio solo a deepseek_in (un promedio) y a deepseek_out.
# Ejemplo de forma (los valores son inventados): USAGE_PRICES={"deepgram_s":0.0001,"eleven_chars":0.00005}
USAGE_PRICES=

# Compuerta del micrófono: suspendido, o con música o un encargo en curso y 20 s sin hablar, el navegador solo envía
# audio cuando detecta voz (ahorra minutos de escucha). MIC_GATE=0 la apaga. MIC_GATE_RMS: volumen (0..1) que cuenta
# como voz; súbelo si el ruido del lugar la mantiene abierta, bájalo si no oye a quien habla bajito.
MIC_GATE=1
MIC_GATE_RMS=0.012

# Taller: al terminar un encargo el servidor revisa el sitio publicado (enlaces, imágenes, estilos y scripts locales).
# Además, si el package.json del proyecto tiene los scripts "test" o "lint", el servidor corre npm test y npm run lint
# (como el usuario del taller y sin las claves del avatar). Si algo falla, Claude Code recibe la salida y hace otra pasada.
# El encargo solo queda "verificado" cuando todo pasa. TALLER_AUTO_FIX=0 deja una sola pasada (comprueba pero no corrige).
TALLER_AUTO_FIX=1
# Pasadas como máximo por encargo, comprobaciones seguidas sin ningún cambio que detienen el ciclo, y segundos por comando.
# El tiempo total del encargo (todas las pasadas) sigue siendo TALLER_MAX_MINUTES.
TALLER_MAX_PASSES=4
TALLER_NO_PROGRESS=2
TALLER_GATE_SECONDS=300
# Revisor independiente: al cerrar un encargo, otro Claude Code que no vio el trabajo lee el resultado (solo lectura) y da
# su opinión. Informa, no bloquea. Gasta suscripción en cada encargo: TALLER_REVIEW=0 lo apaga. Su tiempo (segundos) se
# suma al del encargo. TALLER_REVIEW_MODEL vacío = el mismo modelo del encargo (fable, opus, sonnet o haiku).
TALLER_REVIEW=1
TALLER_REVIEW_SECONDS=240
TALLER_REVIEW_MODEL=
# Modelo "auto" (cuando Javier dice "elige tú"): la capa de decisiones juzga si el encargo es pequeño, normal o exigente
# y se usa el modelo de esa posición. Con Jev empieza en modo sombra (panel → Decisiones): mientras tanto usa CLAUDE_MODEL.
TALLER_AUTO_MODELS=haiku,sonnet,opus
# Auditoría por voz ("audita el proyecto X"): tres lectores de solo lectura en paralelo. Segundos como máximo.
TALLER_AUDIT_SECONDS=300

# Base de datos. Con DATABASE_URL el avatar usa PostgreSQL; vacía, usa SQLite en DATA_DIR (como antes).
# En Easypanel: crea un servicio Postgres y pega aquí su URL de conexión INTERNA (postgres://usuario:clave@host:5432/base).
# La primera vez copia a la base lo que había en DATA_DIR (interesados, llamadas, consumo, dispositivos, proyectos).
DATABASE_URL=
# Guardar también las conversaciones del sitio (las llamadas siempre se guardan). 1 = sí. Si lo activas, avisa a los
# visitantes que la conversación queda registrada.
SAVE_CONVERSATIONS=0

# Taller: cuántos encargos seguidos comparte una misma sesión de Claude Code. Al llegar al tope, el siguiente encargo
# empieza una sesión nueva que arranca leyendo el archivo ESTADO.md del proyecto (así no relee toda la conversación).
TALLER_SESSION_JOBS=4

# Imágenes en pantalla (galería al lado del avatar; la seleccionada va de fondo).
# UNSPLASH_ACCESS_KEY: búsqueda de fotos, gratis. Regístrate en https://unsplash.com/developers , crea una aplicación y
#   copia el "Access Key" (no el Secret). En modo demo permite 50 búsquedas por hora. Vacía = sin búsqueda de fotos.
# MAGNIFIC_API_KEY: generar imágenes con IA (solo en modo dueño). Se crea en el panel de Magnific, en "API Keys". Gasta
#   créditos de tu cuenta por cada imagen. Vacía = sin generación.
# IMAGES_PER_SESSION: búsquedas de fotos por conversación de un visitante. Topes diarios: búsquedas y generaciones.
UNSPLASH_ACCESS_KEY=
MAGNIFIC_API_KEY=
IMAGES_PER_SESSION=4
IMAGES_DAILY_SEARCHES=150
IMAGES_DAILY_GENERATIONS=20

# Habla costeña: 1 = el avatar usa (y entiende) expresiones de la costa Caribe; 0 = español neutro, como antes.
# Las expresiones salen de prompts/costenol.md (puedes agregar, quitar o corregir líneas ahí).
# HABLA_COSTENA_NIVEL: suave (de vez en cuando) | medio (más o menos en la mitad de las respuestas) | fuerte (casi siempre).
HABLA_COSTENA=0
HABLA_COSTENA_NIVEL=suave

# Vigilancia: cada ALERT_CHECK_MINUTES se revisan la base de datos, Deepgram, DeepSeek (y su saldo) y ElevenLabs; si algo
# falla varias veces seguidas llega un aviso por Telegram, y otro cuando vuelve. 0 = sin vigilancia.
# ALERT_DEEPSEEK_BALANCE: avisa cuando el saldo de DeepSeek baja de esa cifra (en la moneda de la cuenta).
ALERT_CHECK_MINUTES=5
ALERT_DEEPSEEK_BALANCE=2
# Respaldo diario de la base a esa hora (0-23, hora de TIMEZONE; -1 = apagado). Se guardan BACKUP_KEEP archivos en
# DATA_DIR/respaldos y, si BACKUP_TELEGRAM no es 0, también se envía a Telegram (copia fuera del servidor; lleva los
# datos de tus interesados). Para restaurar: npm run restaurar -- <archivo.json.gz>
BACKUP_HOUR=3
BACKUP_KEEP=14
BACKUP_TELEGRAM=1
# Seguimiento: a FOLLOWUP_HOUR llega por Telegram la lista de interesados que llevan FOLLOWUP_DAYS días o más sin
# contactar (-1 = apagado).
FOLLOWUP_HOUR=8
FOLLOWUP_DAYS=2

# Informe de la visita: al cerrar cada conversación pública el modelo la resume (qué preguntó, qué le interesó, dudas) y,
# si mostró interés, te llega por Telegram. El resumen (sin transcripción ni contacto) alimenta el embudo del panel.
# 0 = sin análisis ni aviso; el embudo sigue contando demostraciones y datos dejados, pero no "mostraron interés".
VISIT_REPORTS=1
